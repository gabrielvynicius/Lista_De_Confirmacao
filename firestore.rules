rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function admin() {
      return request.auth != null
        && exists(/databases/$(database)/documents/administradores/$(request.auth.uid))
        && get(/databases/$(database)/documents/administradores/$(request.auth.uid)).data.ativo == true
        && get(/databases/$(database)/documents/administradores/$(request.auth.uid)).data.role == 'admin';
    }

    function validCode(code) {
      return code is string && code.matches('^[a-f0-9]{48}$');
    }

    function validAge(age) {
      return age in ['crianca', 'adolescente', 'adulto'];
    }

    function validAnswer(status) {
      return status in ['confirmado', 'ausente', 'indeciso'];
    }

    function settings() {
      return get(/databases/$(database)/documents/configuracoes/casamento).data;
    }

    function newHistory(before, after) {
      return after.historicoId is string
        && after.historicoId.matches('^[a-f0-9-]{36}$')
        && after.historicoId != before.get('historicoId', null)
        && after.ultimaAlteracaoRespostaEm == request.time
        && after.primeiraRespostaEm ==
          (before.get('primeiraRespostaEm', null) != null ? before.primeiraRespostaEm
            : (after.status == 'pendente' ? null : request.time));
    }

    function eventMatches(id, data, origin) {
      let event = getAfter(/databases/$(database)/documents/convidados/$(id)/historico/$(data.historicoId)).data;
      return event.em == request.time && event.status == data.status
        && event.classificacao == data.classificacao && event.origem == origin
        && event.nomeInformado == data.nomeInformado;
    }

    function sameResponse(a, b) {
      return a.status == b.status && a.classificacao == b.classificacao
        && a.primeiraRespostaEm == b.primeiraRespostaEm
        && a.ultimaAlteracaoRespostaEm == b.ultimaAlteracaoRespostaEm;
    }

    function validInvite(data) {
      return data.keys().hasOnly(['pessoas']) && data.pessoas is list
        && data.pessoas.size() > 0 && data.pessoas.size() <= 100;
    }

    function validPublicPerson(data) {
      return data.keys().hasOnly(['nome', 'status', 'classificacao', 'primeiraRespostaEm', 'ultimaAlteracaoRespostaEm'])
        && data.nome is string && data.nome.size() <= 160 && data.nome.matches('.*[^[:space:]].*')
        && (data.status == 'pendente' || validAnswer(data.status))
        && (data.classificacao == null || validAge(data.classificacao))
        && (data.primeiraRespostaEm == null || data.primeiraRespostaEm is timestamp)
        && (data.ultimaAlteracaoRespostaEm == null || data.ultimaAlteracaoRespostaEm is timestamp);
    }

    function authorizedPerson(code, id) {
      let person = get(/databases/$(database)/documents/convidados/$(id)).data;
      let invite = get(/databases/$(database)/documents/convites/$(code)).data;
      return validCode(code) && person.conviteCodigo == code && validInvite(invite) && id in invite.pessoas
        && (person.get('conviteFamiliaId', null) == null || person.conviteFamiliaId == person.familiaId);
    }

    function publicMirrorUpdate(code, id) {
      let before = resource.data;
      let after = request.resource.data;
      let rules = settings();
      return authorizedPerson(code, id)
        && rules.aberta == true && request.time < rules.prazo
        && ((before.status == 'pendente' && before.primeiraRespostaEm == null) || rules.permitirAlteracoes == true)
        && after.diff(before).affectedKeys().hasOnly([
          'status', 'classificacao', 'primeiraRespostaEm', 'ultimaAlteracaoRespostaEm'
        ])
        && validPublicPerson(after) && validAnswer(after.status) && validAge(after.classificacao)
        && after.ultimaAlteracaoRespostaEm == request.time
        && sameResponse(after, getAfter(/databases/$(database)/documents/convidados/$(id)).data);
    }

    function publicGuestUpdate(id) {
      let before = resource.data;
      let after = request.resource.data;
      let code = before.get('conviteCodigo', '');
      let path = /databases/$(database)/documents/convites/$(code)/pessoas/$(id);
      return validCode(code)
        && after.diff(before).affectedKeys().hasOnly([
          'status', 'classificacao', 'nomeInformado', 'primeiraRespostaEm', 'ultimaAlteracaoRespostaEm', 'historicoId'
        ])
        && newHistory(before, after)
        && sameResponse(after, getAfter(path).data)
        && after.nomeInformado == before.nome && after.nomeInformado == getAfter(path).data.nome
        && after.nomeInformado is string && after.nomeInformado.size() <= 160
        && after.nomeInformado.matches('.*[^[:space:]].*')
        && eventMatches(id, after, 'convidado');
    }

    function validGuestEdit(before, after) {
      let changed = after.diff(before).affectedKeys();
      return (!changed.hasAny(['nome']) || (after.nome is string && after.nome.size() > 0 && after.nome.size() <= 160))
        && (!changed.hasAny(['telefone']) || (after.telefone is string && after.telefone.size() <= 40))
        && (!changed.hasAny(['observacoes']) || (after.observacoes is string && after.observacoes.size() <= 2000))
        && (!changed.hasAny(['familiaId']) || after.familiaId == null || after.familiaId is string)
        && (!changed.hasAny(['classificacao']) || validAge(after.classificacao))
        && (!changed.hasAny(['status']) || after.status == 'pendente' || validAnswer(after.status));
    }

    function adminAttendance(id, before, after) {
      let changed = after.diff(before).affectedKeys();
      return !changed.hasAny([
          'status', 'classificacao', 'nomeInformado', 'primeiraRespostaEm', 'ultimaAlteracaoRespostaEm', 'historicoId'
        ])
        || (before.get('historicoId', null) == null && before.get('status', 'pendente') == 'pendente'
          && after.status == 'pendente'
          && !changed.hasAny(['nomeInformado', 'primeiraRespostaEm', 'ultimaAlteracaoRespostaEm', 'historicoId']))
        || ((validAnswer(after.status) || after.status == 'pendente') && validAge(after.classificacao)
          && newHistory(before, after) && eventMatches(id, after, 'administracao'));
    }

    match /administradores/{uid} {
      allow get: if request.auth != null && request.auth.uid == uid;
      allow list: if admin();
    }

    function validSettings(data) {
      return data.keys().hasOnly(['prazo', 'aberta', 'permitirAlteracoes'])
        && data.prazo is timestamp && data.aberta is bool && data.permitirAlteracoes is bool;
    }

    match /configuracoes/casamento {
      allow get: if admin() || resource == null || validSettings(resource.data);
      allow create, update: if admin() && validSettings(request.resource.data);
    }

    match /convidados/{id} {
      allow read, delete: if admin();
      allow create: if admin() && request.resource.data.keys().hasAll(['nome', 'classificacao', 'status'])
        && validGuestEdit({}, request.resource.data) && adminAttendance(id, {}, request.resource.data);
      allow update: if (admin() && validGuestEdit(resource.data, request.resource.data)
        && adminAttendance(id, resource.data, request.resource.data))
        || publicGuestUpdate(id);

      match /historico/{eventId} {
        allow read: if admin();
        allow create: if request.resource.data.keys().hasOnly(['status', 'classificacao', 'nomeInformado', 'em', 'origem'])
          && request.resource.data.em == request.time
          && ((request.resource.data.origem == 'administracao' && admin())
            || (request.resource.data.origem == 'convidado' && validAnswer(request.resource.data.status)))
          && getAfter(/databases/$(database)/documents/convidados/$(id)).data.historicoId == eventId
          && getAfter(/databases/$(database)/documents/convidados/$(id)).data.ultimaAlteracaoRespostaEm == request.time;
      }
    }

    match /convites/{code} {
      allow get: if admin() || (validCode(code) && (resource == null || validInvite(resource.data)));
      allow list, delete: if admin();
      allow create, update: if admin() && validCode(code) && validInvite(request.resource.data);

      match /pessoas/{id} {
        allow get: if admin() || (authorizedPerson(code, id) && validPublicPerson(resource.data));
        allow list, delete: if admin();
        allow create: if admin() && validPublicPerson(request.resource.data);
        allow update: if (admin() && validPublicPerson(request.resource.data)) || publicMirrorUpdate(code, id);
      }
    }

    function anonymousOwner(uid) {
      return request.auth != null && request.auth.uid == uid
        && request.auth.token.firebase.sign_in_provider == 'anonymous';
    }

    function publicRsvpOpen(editing) {
      let activation = get(/databases/$(database)/documents/configuracoes/rsvpPublico).data;
      let wedding = get(/databases/$(database)/documents/configuracoes/casamento).data;
      return activation.ativa == true
        && wedding.aberta == true && wedding.prazo is timestamp && request.time < wedding.prazo
        && (!editing || wedding.permitirAlteracoes == true);
    }

    function validRsvpSlot(slot) {
      return slot.matches('^([1-9]|1[0-2])$');
    }

    function validRsvpName(name) {
      return name is string && name.size() <= 160
        && name.matches("^\\p{L}[\\p{L}\\p{M}]*(?:[ '’‐‑-]\\p{L}[\\p{L}\\p{M}]*)*$")
        && !name.matches('.*[\\x{180B}-\\x{180D}\\x{180F}\\x{20E3}\\x{2139}\\x{FE00}-\\x{FE0F}\\x{E0100}-\\x{E01EF}].*');
    }

    function validRsvpResponse(data) {
      return data.keys().hasAll([
          'nome', 'classificacao', 'status', 'versao', 'eventoId', 'criadoEm', 'atualizadoEm'
        ])
        && data.keys().hasOnly([
          'nome', 'classificacao', 'status', 'versao', 'eventoId', 'criadoEm', 'atualizadoEm'
        ])
        && validRsvpName(data.nome) && validAge(data.classificacao) && validAnswer(data.status)
        && data.versao is int && data.eventoId is string
        && data.criadoEm is timestamp && data.atualizadoEm == request.time;
    }

    function rsvpHistoryPath(uid, slot, eventId) {
      return /databases/$(database)/documents/rsvpEnvios/$(uid)/rsvpPessoas/$(slot)/historico/$(eventId);
    }

    function rsvpState(data) {
      return { 'nome': data.nome, 'classificacao': data.classificacao, 'status': data.status, 'versao': data.versao };
    }

    function rsvpEventMatches(uid, slot, eventId, data, kind, origin) {
      let event = getAfter(rsvpHistoryPath(uid, slot, eventId)).data;
      return event.tipo == kind && event.origem == origin && event.em == request.time
        && event.estado == rsvpState(data);
    }

    function rsvpResponsePath(uid, slot) {
      return /databases/$(database)/documents/rsvpEnvios/$(uid)/rsvpPessoas/$(slot);
    }

    function validRsvpEventWrite(uid, slot, eventId) {
      let path = rsvpResponsePath(uid, slot);
      let event = request.resource.data;
      return event.keys().hasOnly(['tipo', 'origem', 'em', 'estado'])
        && event.em == request.time
        && (
          (eventId == 'exclusao' && admin() && event.tipo == 'exclusao'
            && event.origem == 'administracao' && !existsAfter(path)
            && event.estado == rsvpState(get(path).data))
          || (eventId != 'exclusao'
            && ((event.origem == 'administracao' && admin())
              || (event.origem == 'convidado' && anonymousOwner(uid)))
            && getAfter(path).data.eventoId == eventId
            && getAfter(path).data.atualizadoEm == request.time)
        );
    }

    match /configuracoes/rsvpPublico {
      allow get: if admin() || resource == null
        || (resource.data.keys().hasOnly(['ativa']) && resource.data.ativa is bool);
      allow create, update: if admin() && request.resource.data.keys().hasOnly(['ativa'])
        && request.resource.data.ativa is bool;
    }

    // O UID é parte do caminho e não é controlado pelos campos do documento.
    match /rsvpEnvios/{uid}/rsvpPessoas/{slot} {
      allow get, list: if admin() || anonymousOwner(uid);

      allow create: if validRsvpSlot(slot) && anonymousOwner(uid) && publicRsvpOpen(false)
        && validRsvpResponse(request.resource.data)
        && request.resource.data.versao == 1 && request.resource.data.eventoId == 'inicio'
        && request.resource.data.criadoEm == request.time
        && !exists(rsvpHistoryPath(uid, slot, 'inicio'))
        && rsvpEventMatches(uid, slot, 'inicio', request.resource.data, 'criacao', 'convidado');

      allow update: if validRsvpSlot(slot) && validRsvpResponse(request.resource.data)
        && request.resource.data.eventoId.matches('^[a-f0-9-]{36}$')
        && request.resource.data.eventoId != resource.data.eventoId
        && request.resource.data.versao == resource.data.versao + 1
        && request.resource.data.criadoEm == resource.data.criadoEm
        && request.resource.data.diff(resource.data).affectedKeys().hasAny(['nome', 'classificacao', 'status'])
        && (
          (admin() && rsvpEventMatches(uid, slot, request.resource.data.eventoId,
            request.resource.data, 'alteracao', 'administracao'))
          || (anonymousOwner(uid) && publicRsvpOpen(true)
            && rsvpEventMatches(uid, slot, request.resource.data.eventoId,
              request.resource.data, 'alteracao', 'convidado'))
        );

      allow delete: if admin()
        && rsvpEventMatches(uid, slot, 'exclusao', resource.data, 'exclusao', 'administracao');

      match /historico/{eventId} {
        allow read: if admin();
        allow create: if validRsvpSlot(slot) && validRsvpEventWrite(uid, slot, eventId);
      }
    }

    // Nome de coleção reservado para a listagem administrativa entre envios.
    match /{path=**}/rsvpPessoas/{slot} {
      allow list: if admin();
    }

    match /familias/{id} {
      allow read, write: if admin();
    }

    match /confirmacoes/{id} {
      allow read, write: if admin();
    }

    match /presentes/{id} {
      allow read, write: if admin();
    }
  }
}
